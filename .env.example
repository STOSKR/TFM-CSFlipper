# Supabase/Postgres
# DATABASE_URL must be the PostgreSQL connection string from Supabase "Connect".
# Do not put the project URL (https://....supabase.co) in this field.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# SPADE/XMPP
XMPP_SERVER=localhost
XMPP_DOMAIN=localhost
BROKER_AGENT_JID=broker@localhost
BROKER_AGENT_PASSWORD=
ANALYST_AGENT_JID=analyst@localhost
ANALYST_AGENT_PASSWORD=

# OCR
TESSERACT_CMD=
OCR_LANGUAGE=eng

# Runtime
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Render scrape job server
SCRAPE_JOB_TOKEN=
SCRAPE_STREAMING=false
SCRAPE_STALE_MINUTES=480
SCRAPE_CANDIDATE_LIMIT=
SCRAPE_ALL_PROFILES=
SCRAPE_STEAMDT_TIMEOUT=
SCRAPE_STEAMDT_RETRIES=
SCRAPE_STEAMDT_PROFILE_TIMEOUT=
SCRAPE_REFRESH_LIMIT=
SCRAPE_BATCH_SIZE=
SCRAPE_QUEUE_SIZE=
SCRAPE_STEAM_CONCURRENCY=2
SCRAPE_BUFF_CONCURRENCY=2
SCRAPE_BUFF_CAPTCHA_WAIT_SECONDS=300
SCRAPE_CONCURRENT_PLATFORMS=false
SCRAPE_STEAM=true
SCRAPE_BUFF=true
SCRAPE_STEAM_API=false
SCRAPE_REFRESH=true
SCRAPE_SCORE=true
SCRAPE_REFRESH_ONLY=false
SCRAPE_PERSIST=true
SCRAPE_SHOW_BROWSER=false
SCRAPE_ENSURE_PLAYWRIGHT=true
SCRAPE_JOB_TIMEOUT_SECONDS=
SCRAPE_JOB_STALL_SECONDS=120
SCRAPE_JOB_RETRIES=1
PLAYWRIGHT_BROWSERS_PATH=0
