# Base de datos local: copia la cadena de «Connect > Session pooler» de Supabase.
# No uses la URL del proyecto (https://<proyecto>.supabase.co): no es una base de datos.
# Sustituye la contraseña y codifica sus caracteres especiales (%40 para @, %23 para #, etc.).
# El proyecto convierte automáticamente postgresql+asyncpg:// al formato que necesita asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Solo se usa como valor seguro por defecto. El panel lo activa temporalmente al iniciar sesión.
SCRAPE_SHOW_BROWSER=false
