# Supabase/Postgres
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/csflipper

# SPADE/XMPP
XMPP_SERVER=localhost
XMPP_DOMAIN=localhost
BROKER_AGENT_JID=broker@localhost
BROKER_AGENT_PASSWORD=
ANALYST_AGENT_JID=analyst@localhost
ANALYST_AGENT_PASSWORD=

# OCR
TESSERACT_CMD=
OCR_LANGUAGE=eng

# Runtime
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Render scrape job server
SCRAPE_JOB_TOKEN=
SCRAPE_STALE_MINUTES=480
SCRAPE_CANDIDATE_LIMIT=
SCRAPE_REFRESH_LIMIT=
SCRAPE_PERSIST=true
SCRAPE_SHOW_BROWSER=false
SCRAPE_ENSURE_PLAYWRIGHT=true
SCRAPE_JOB_TIMEOUT_SECONDS=
PLAYWRIGHT_BROWSERS_PATH=0
